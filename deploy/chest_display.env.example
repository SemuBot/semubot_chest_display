# Copied to ~/.config/semubot/chest_display.env by install.sh; that copy is not in git.

# PIN for the admin menu (swipe up on the display). Without it the admin menu stays locked.
CHEST_DISPLAY_ADMIN_PASSWORD=

# Which monitor is the chest screen (connector name from `xrandr --query`).
# The app looks up its current size and position, so screen layout changes don't matter.
CHEST_DISPLAY_MONITOR=HDMI-2
# Or a fixed position instead, WIDTHxHEIGHT+X+Y (overrides CHEST_DISPLAY_MONITOR):
# CHEST_DISPLAY_GEOMETRY=1280x800+1920+0
